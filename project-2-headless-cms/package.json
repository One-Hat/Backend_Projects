{
  "name": "headless-cms",
  "version": "1.0.0",
  "description": "Production-grade headless CMS backend with GraphQL Yoga, Fastify, Prisma, and PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "test:e2e": "tsx test/e2e.ts"
  },
  "keywords": [
    "headless-cms",
    "graphql",
    "prisma",
    "postgresql",
    "fastify",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.13.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
